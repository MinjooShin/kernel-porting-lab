From 265f7ed74a3f2c8fa0a806e8a5584123e3e44506 Mon Sep 17 00:00:00 2001
From: mjshin <mjshin@nextchip.com>
Date: Thu, 26 Nov 2026 14:11:00 +0900
Subject: [PATCH] arm64: dts: add MJ board with UART and SD

---
 arch/arm64/boot/dts/Makefile    |   1 +
 arch/arm64/boot/dts/mj/Makefile |   1 +
 arch/arm64/boot/dts/mj/mj.dts   |  35 +++++++
 arch/arm64/boot/dts/mj/mj.dtsi  | 179 ++++++++++++++++++++++++++++++++
 4 files changed, 216 insertions(+)
 create mode 100644 arch/arm64/boot/dts/mj/Makefile
 create mode 100644 arch/arm64/boot/dts/mj/mj.dts
 create mode 100644 arch/arm64/boot/dts/mj/mj.dtsi

diff --git a/arch/arm64/boot/dts/Makefile b/arch/arm64/boot/dts/Makefile
index b0844404eda1..3d8789d5c98d 100644
--- a/arch/arm64/boot/dts/Makefile
+++ b/arch/arm64/boot/dts/Makefile
@@ -38,3 +38,4 @@ subdir-y += tesla
 subdir-y += ti
 subdir-y += toshiba
 subdir-y += xilinx
+subdir-y += mj
\ No newline at end of file
diff --git a/arch/arm64/boot/dts/mj/Makefile b/arch/arm64/boot/dts/mj/Makefile
new file mode 100644
index 000000000000..271bd0dbb35b
--- /dev/null
+++ b/arch/arm64/boot/dts/mj/Makefile
@@ -0,0 +1 @@
+dtb-y += mj.dtb
\ No newline at end of file
diff --git a/arch/arm64/boot/dts/mj/mj.dts b/arch/arm64/boot/dts/mj/mj.dts
new file mode 100644
index 000000000000..b1563469ad56
--- /dev/null
+++ b/arch/arm64/boot/dts/mj/mj.dts
@@ -0,0 +1,35 @@
+
+/dts-v1/;
+
+#include "mj.dtsi"
+
+
+/ {
+    model = "MJ Board"; 
+    compatible = "mj,lab-board";
+
+    aliases {
+        serial0 = &uart3;
+    };
+
+    chosen {
+        stdout-path = "serial0:115200n8";
+    };
+
+    memory@40000000 {
+        device_type = "memory";
+        reg = <0x0 0x40000000 0x0 0xc0000000>;
+    };
+
+};
+
+&uart3 {
+    status = "okay";
+};
+
+&mmc1 {
+    status = "okay";
+    bus-width = <4>;
+    disable-wp;
+    no-1-8-v;
+};
diff --git a/arch/arm64/boot/dts/mj/mj.dtsi b/arch/arm64/boot/dts/mj/mj.dtsi
new file mode 100644
index 000000000000..e921d9bd3f2e
--- /dev/null
+++ b/arch/arm64/boot/dts/mj/mj.dtsi
@@ -0,0 +1,179 @@
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+/ {
+    compatible = "mj,lab-board";
+    interrupt-parent = <&gic>;
+    #address-cells = <2>;
+    #size-cells = <2>;
+
+    cpus {
+        #address-cells = <2>;
+        #size-cells = <0>;
+
+        cpu-map {
+            cluster0 {
+                core0 {thread0 {cpu = <&cpu0>;}; thread1 {cpu = <&cpu1>;};};
+                core1 {thread0 {cpu = <&cpu2>;}; thread1 {cpu = <&cpu3>;};};
+                core2 {thread0 {cpu = <&cpu4>;}; thread1 {cpu = <&cpu5>;};};
+                core3 {thread0 {cpu = <&cpu6>;}; thread1 {cpu = <&cpu7>;};};
+            };
+        };
+
+        cpu0: cpu@0 {
+            device_type = "cpu";
+            compatible = "arm,cortex-a65";
+            reg = <0x0 0x0>;
+            next-level-cache = <&L2_0>;
+            enable-method = "psci";
+        };
+        cpu1: cpu@1 {
+            device_type = "cpu";
+            compatible = "arm,cortex-a65";
+            reg = <0x0 0x1>;
+            next-level-cache = <&L2_0>;
+            enable-method = "psci";
+        };
+        cpu2: cpu@100 {
+            device_type = "cpu";
+            compatible = "arm,cortex-a65";
+            reg = <0x0 0x100>;
+            next-level-cache = <&L2_1>;
+            enable-method = "psci";
+        };
+        cpu3: cpu@101 {
+            device_type = "cpu";
+            compatible = "arm,cortex-a65";
+            reg = <0x0 0x101>;
+            next-level-cache = <&L2_1>;
+            enable-method = "psci";
+        };
+        cpu4: cpu@200 {
+            device_type = "cpu";
+            compatible = "arm,cortex-a65";
+            reg = <0x0 0x200>;
+            next-level-cache = <&L2_2>;
+            enable-method = "psci";
+        };
+        cpu5: cpu@201 {
+            device_type = "cpu";
+            compatible = "arm,cortex-a65";
+            reg = <0x0 0x201>;
+            next-level-cache = <&L2_2>;
+            enable-method = "psci";
+        };
+        cpu6: cpu@300 {
+            device_type = "cpu";
+            compatible = "arm,cortex-a65";
+            reg = <0x0 0x300>;
+            next-level-cache = <&L2_3>;
+            enable-method = "psci";
+        };
+        cpu7: cpu@301 {
+            device_type = "cpu";
+            compatible = "arm,cortex-a65";
+            reg = <0x0 0x301>;
+            next-level-cache = <&L2_3>;
+            enable-method = "psci";
+        };
+    };
+
+    L2_0: l2-cache0 {
+        compatible = "cache";
+        cache-level = <2>;
+        cache-unified;
+        next-level-cache = <&L3_0>;
+    };
+
+    L2_1: l2-cache1 {
+        compatible = "cache";
+        cache-level = <2>;
+        cache-unified;
+        next-level-cache = <&L3_0>;
+    };
+
+    L2_2: l2-cache2 {
+        compatible = "cache";
+        cache-level = <2>;
+        cache-unified;
+        next-level-cache = <&L3_0>;
+    };
+
+    L2_3: l2-cache3 {
+        compatible = "cache";
+        cache-level = <2>;
+        cache-unified;
+        next-level-cache = <&L3_0>;
+    };
+
+    L3_0: l3-cache0 {
+        compatible = "cache";
+        cache-level = <3>;
+        cache-unified;
+    };
+
+    psci {
+        compatible = "arm,psci-0.2";
+        method = "smc";
+    };
+
+    timer {
+        compatible = "arm,armv8-timer";
+        interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,   /* Physical Secure */
+                     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,   /* Physical Non-Secure */
+                     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,   /* Virtual */
+                     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;   /* Hypervisor */
+        clock-frequency = <25000000>; 
+    };
+
+    soc {
+        compatible = "simple-bus";
+        #address-cells = <2>;
+        #size-cells = <2>;
+        ranges;
+
+        gic: interrupt-controller@4000000 {
+            compatible = "arm,gic-v3";
+            #interrupt-cells = <3>;
+            #address-cells = <2>;
+            #size-cells = <2>;
+            ranges;
+            interrupt-controller;
+            reg = <0x0 0x04000000 0x0 0x10000>,     /* GICD */
+                <0x0 0x04060000 0x0 0x100000>;    /* GICR */
+            
+            /* GICC, GICH, GICV are located inside of CPU */
+            interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
+        };
+
+        uart3: serial@6430000 {
+            compatible = "snps,dw-apb-uart";
+            reg = <0x0 0x6430000 0x0 0x100>;
+            interrupt-parent = <&gic>;
+            interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>;
+            reg-shift = <2>;
+            reg-io-width = <4>;
+            clock-frequency = <40000000>;
+            status = "disabled";
+        };
+
+        /* Dummy "core" clock required for sdhci probe; the driver derives
+           the base clock from the caps register (250MHz), not this rate. */
+        sdclk: sdclk {
+            compatible = "fixed-clock";
+            #clock-cells = <0>;
+            clock-frequency = <200000000>;
+        };
+
+        mmc1: mmc@a000000 {
+            compatible = "snps,dwcmshc-sdhci";
+            reg = <0x0 0x0A000000 0x0 0x100000>;
+            interrupts = <GIC_SPI 117 IRQ_TYPE_LEVEL_HIGH>;
+            clocks = <&sdclk>;
+            clock-names = "core";
+            sdhci-caps-mask = <0x00FF0000 0x00000000>;
+            status = "disabled";
+        };
+    };
+   
+
+};
\ No newline at end of file
-- 
2.25.1

