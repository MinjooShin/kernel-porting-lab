From 6e99744997a7c36e52367ef40d576aea87d3813e Mon Sep 17 00:00:00 2001
From: mjshin <mjshin@nextchip.com>
Date: Thu, 26 Nov 2026 14:12:37 +0900
Subject: [PATCH] configs/board: add MJ board rootfs overlay and defconfig

---
 board/mj/rootfs_overlay/etc/init.d/S99userdata | 9 +++++++++
 configs/mj_defconfig                           | 9 +++++++++
 2 files changed, 18 insertions(+)
 create mode 100755 board/mj/rootfs_overlay/etc/init.d/S99userdata
 create mode 100644 configs/mj_defconfig

diff --git a/board/mj/rootfs_overlay/etc/init.d/S99userdata b/board/mj/rootfs_overlay/etc/init.d/S99userdata
new file mode 100755
index 00000000..1c631bd3
--- /dev/null
+++ b/board/mj/rootfs_overlay/etc/init.d/S99userdata
@@ -0,0 +1,9 @@
+#!/bin/sh
+case "$1" in
+    start)
+        mount -t ext4 /dev/mmcblk0p2 /mnt
+        ;;
+    stop)
+        umount /mnt
+        ;;
+esac
diff --git a/configs/mj_defconfig b/configs/mj_defconfig
new file mode 100644
index 00000000..20e51374
--- /dev/null
+++ b/configs/mj_defconfig
@@ -0,0 +1,9 @@
+BR2_aarch64=y
+BR2_cortex_a55=y
+BR2_TOOLCHAIN_EXTERNAL=y
+BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
+BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
+BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
+BR2_ROOTFS_OVERLAY="board/mj/rootfs_overlay"
+BR2_TARGET_ROOTFS_CPIO=y
+BR2_TARGET_ROOTFS_CPIO_GZIP=y
-- 
2.25.1

